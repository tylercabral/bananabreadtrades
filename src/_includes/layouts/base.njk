<!doctype html>
<html lang="en">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>{% if title %}{{ title }} · {% endif %}{{ site.name }}</title>
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Big+Shoulders+Display:wght@600;800&family=Source+Serif+4:ital,opsz,wght@0,8..60,400;0,8..60,600;1,8..60,400&family=JetBrains+Mono:wght@400;600&display=swap">
<link rel="stylesheet" href="/css/site.css">
</head>
<body>
<div class="wrap">
  <header>
    <a class="brand" href="/">{% include "bananas.svg.njk" %}<b>{{ site.name }}</b></a>
    <nav aria-label="Main">
      {%- for item in nav %}
      <a href="{{ item.url }}"{% if page.url == item.url or (item.url != "/" and page.url.startsWith(item.url)) %} aria-current="page"{% endif %}>{{ item.label }}</a>
      {%- endfor %}
    </nav>
  </header>
  {%- set latest = collections.journal[0] %}
  <div class="tape" aria-hidden="true">
    {% if latest %}<span>LAST RECAP <em>{{ latest.data.ticker }}</em>{% if latest.data.change %} <span class="{{ 'u' if latest.data.change.startsWith('+') else 'd' }}">{{ latest.data.change }}</span>{% endif %}</span>
    <span>LATEST <em>{{ (collections.plays | findPlay(latest.data.play)).data.title if (collections.plays | findPlay(latest.data.play)) else latest.data.play }}</em></span>{% endif %}
    <span>RECAPS LOGGED <em>{{ collections.journal.length }}</em></span>
    <span>TIMES SHOWN <em>Pacific</em></span>
  </div>
  <main id="top">
{{ content | safe }}
  </main>
  <footer>
    <p>{{ site.disclaimer | safe }}</p>
    <span>© 2026 {{ site.name }}</span>
  </footer>
</div>
</body>
</html>
